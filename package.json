{
  "name": "lotwise-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "annotations": "node scripts/annotations.mjs",
    "prebuild": "node scripts/annotations.mjs",
    "e2e": "playwright test",
    "engine:build": "bash scripts/build-engine.sh",
    "engine:test": "cargo test --manifest-path engine/Cargo.toml",
    "engine:check": "bash scripts/build-engine.sh && git diff --exit-code --stat -- lib/engine/wasm mcp/dist",
    "mcp:build": "npm --prefix mcp run build",
    "mcp:test": "npm --prefix mcp test",
    "mcp:check": "npm --prefix mcp run build && git diff --exit-code --stat -- mcp/dist"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.8",
    "@types/mdx": "^2.0.14",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "bin": {
    "lotwise-mcp": "mcp/dist/lotwise-mcp.mjs"
  }
}
